		sourceColumn: doc_type

	column date_written
		dataType: string
		lineageTag: 29478d36-17a7-4691-9cc7-3b113065ae72
		summarizeBy: none
		sourceColumn: date_written

	column digitized_at
		dataType: dateTime
		lineageTag: 03656ee5-6186-40d6-9dd5-75263ba3ab81
		summarizeBy: none
		sourceColumn: digitized_at

	column physical_condition
		dataType: string
		lineageTag: b29a668f-beeb-4eef-b383-b6da4a978178
		summarizeBy: none
		sourceColumn: physical_condition

	column collection_name
		dataType: string
		lineageTag: 8db8f51e-f636-4094-a684-0ba16d935c70
		summarizeBy: none
		sourceColumn: collection_name

	column archive_name
		dataType: string
		lineageTag: 00ac6c4f-b62d-4900-8e9f-03145a84d834
		summarizeBy: none
		sourceColumn: archive_name

	column era
		dataType: string
		lineageTag: 08bf8a5f-b125-4e27-bf0b-070da3581f9c
		summarizeBy: none
		sourceColumn: era

	column author_names
		dataType: string
		lineageTag: 58fd5ad9-9d77-4323-94a4-df40f7222a9e
		summarizeBy: none
		sourceColumn: author_names

	column ocr_status
		dataType: string
		lineageTag: 561916f1-2a7f-4cd4-a2ec-4c52ef805b1e
		summarizeBy: none
		sourceColumn: ocr_status

	column collection_id
		dataType: int64
		lineageTag: 43fed0c6-a135-4a24-b3ef-f9b6b9cc305d
		summarizeBy: none
		sourceColumn: collection_id

	column archive_id
		dataType: int64
		lineageTag: 434a205d-57ac-4360-abff-400f31d9875b
		summarizeBy: none
		sourceColumn: archive_id

	column 'Digitization Day' = IF(ISBLANK(documents[digitized_at]),BLANK(),DATE(YEAR(documents[digitized_at]),MONTH(documents[digitized_at]),DAY(documents[digitized_at])))
		dataType: dateTime
		formatString: dd MMM yyyy
		lineageTag: baa6f396-fd7b-41c9-84f5-6e480537b299
		summarizeBy: none

	column 'Recorded OCR' = IF(ISBLANK(LOOKUPVALUE(ai_analytics[ocr_engine],ai_analytics[document_id],documents[document_id])),"No recorded OCR result","OCR result recorded")
		dataType: string
		lineageTag: e647498d-747b-442f-8662-6569d831b5fa
		summarizeBy: none

	column 'Recorded Prediction' = COALESCE(LOOKUPVALUE(ai_analytics[predicted_condition],ai_analytics[document_id],documents[document_id]),"No recorded prediction")
		dataType: string
		lineageTag: 5407ad68-874c-4561-b926-5928f3e234f4
		summarizeBy: none

	partition documents = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ExportFolder & "/documents.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Nulls, {{"document_id", Int64.Type}, {"title", type text}, {"doc_type", type text}, {"date_written", type text}, {"digitized_at", type datetime}, {"physical_condition", type text}, {"collection_name", type text}, {"archive_name", type text}, {"era", type text}, {"author_names", type text}, {"ocr_status", type text}, {"collection_id", Int64.Type}, {"archive_id", Int64.Type}}, "en-US"),
				    Clean = Table.ReplaceErrorValues(Typed, List.Transform(Table.ColumnNames(Typed), each {_, null}))
				in
				    Clean
